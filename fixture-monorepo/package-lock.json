{
  "name": "thinkmay-fixture-monorepo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "thinkmay-fixture-monorepo",
      "version": "1.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/web": {
      "name": "@thinkmay-fixture/web",
      "version": "1.0.0",
      "dependencies": {
        "@thinkmay-fixture/message": "1.0.0"
      }
    },
    "node_modules/@thinkmay-fixture/message": {
      "resolved": "packages/message",
      "link": true
    },
    "node_modules/@thinkmay-fixture/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/message": {
      "name": "@thinkmay-fixture/message",
      "version": "1.0.0"
    }
  }
}
